# JWT signing secret (HS256). Required in production; dev falls back to a constant.
ARAG_JWT_SECRET=

# Optional: when set, the summarize step generates a real answer via Claude.
# Without it, the app streams the curated sample answer so the full flow still works.
ANTHROPIC_API_KEY=

# web → Postgres
DATABASE_URL=postgres://arag:arag@localhost:5432/arag
# web → rag サービス
RAG_SERVICE_URL=http://localhost:8000
RAG_INTERNAL_TOKEN=dev-internal-token
