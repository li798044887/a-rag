# ─── web (.env.local) ──────────────────────────────────────────────────────────

# JWT signing secret (HS256). Required in production; dev falls back to a constant.
ARAG_JWT_SECRET=

# Claude API key. Required when a claude-* model is selected (the summarize step).
# Without it, retrieval and citations still work, but generation is skipped and
# the app returns a short notice instead of an answer.
ANTHROPIC_API_KEY=

# OpenAI API key. Required when a gpt-* model is selected.
OPENAI_API_KEY=

# DeepSeek API key. Required when a deepseek-* model is selected.
# Get your key at https://platform.deepseek.com
DEEPSEEK_API_KEY=

# OpenAI-compatible endpoint (internal / local LLM). Set only when routing gpt-*
# calls somewhere other than OpenAI itself. Leave unset to use OpenAI.
# OPENAI_BASE_URL=

# web → Postgres (node-postgres DSN)
# rag uses a separate postgresql+psycopg:// DSN set inside docker-compose.yml
DATABASE_URL=postgres://arag:arag@localhost:5432/arag

# web → rag internal HTTP base URL
RAG_SERVICE_URL=http://localhost:8000

# Shared secret for web↔rag internal auth (X-Internal-Token header)
RAG_INTERNAL_TOKEN=dev-internal-token

# ─── rag (docker-compose env / rag/.env) ───────────────────────────────────────
# These are set directly in docker-compose.yml; listed here for reference.

# rag → Postgres (psycopg3 DSN)
# DATABASE_URL=postgresql+psycopg://arag:arag@localhost:5432/arag

# Qdrant HTTP URL
# QDRANT_URL=http://localhost:6333

# Redis URL (arq job queue)
# REDIS_URL=redis://localhost:6379

# Model execution device: cpu | cuda
# DEVICE=cpu

# Embedding model: bge-m3 | stub  (stub = fast offline stub for tests)
# EMBEDDER=bge-m3

# Reranker model: bge | stub
# RERANKER=bge

# Set to "1" to preload models at startup (compose rag service sets this)
# EMBEDDER=stub のときは preload をスキップ（テスト/オフライン）
# PRELOAD_MODELS=1
